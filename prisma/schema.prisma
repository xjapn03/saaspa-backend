generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  EMPLEADO
  ADMIN
}

enum BookingStatus {
  PENDIENTE_PAGO
  CONFIRMADA
  CANCELADA
  COMPLETADA
  NO_ASISTIO
}

enum PaymentType {
  ABONO
  SALDO
}

enum PaymentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum PaymentMethod {
  WOMAPI
  EFECTIVO
  TRANSFERENCIA
}


model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  birthday     DateTime?
  description  String?   @db.Text
  role         Role      @default(CLIENTE)
  isActive     Boolean   @default(true)
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]
  payments     Payment[]
  coupons      Coupon[]
  couponUsages CouponUsage[]
  cartItems    CartItem[]
  orders       Order[]

  @@map("users")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int
  isActive    Boolean  @default(true)
  categoryId  String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryRel  Category? @relation(fields: [categoryId], references: [id])
  bookings    Booking[]

  @@map("services")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  parentId    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  services    Service[]
  products    Product[]

  @@map("categories")
}

model Product {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  description     String?   @db.Text
  price           Decimal   @db.Decimal(10, 2)
  compareAtPrice  Decimal?  @db.Decimal(10, 2)
  stock           Int       @default(0)
  sku             String?   @unique
  mainImage       String?
  carouselImages  Json?
  sponsor         String?
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  categoryId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        Category? @relation(fields: [categoryId], references: [id])
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@map("products")
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  serviceId     String
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus @default(PENDIENTE_PAGO)
  googleEventId String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  service       Service       @relation(fields: [serviceId], references: [id])
  payments      Payment[]

  @@map("bookings")
  @@index([userId, status])
  @@index([startTime])
  @@index([serviceId, startTime])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String?
  userId          String
  amount          Decimal       @db.Decimal(10, 2)
  type            PaymentType   @default(ABONO)
  status          PaymentStatus @default(PENDIENTE)
  wompiPaymentId  String?
  wompiReference  String?
  paymentMethod   PaymentMethod? @default(WOMAPI)
  metadata        Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking         Booking?      @relation(fields: [bookingId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  order           Order?

  @@map("payments")
  @@index([bookingId])
  @@index([status, createdAt])
}

model Coupon {
  id           String   @id @default(uuid())
  code         String   @unique
  discount     Decimal  @db.Decimal(5, 4)
  isActive     Boolean  @default(true)
  maxUses      Int?
  usedCount    Int      @default(0)
  perUserLimit Int      @default(1)
  expiresAt    DateTime
  userId       String?
  createdAt    DateTime @default(now())

  user         User?          @relation(fields: [userId], references: [id])
  usages       CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([couponId, userId])
  @@map("coupon_usages")
}

model ConversationState {
  id        String   @id @default(uuid())
  waId      String   @unique
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversation_states")
}

model ResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("reset_tokens")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  total           Decimal     @db.Decimal(10, 2)
  status          OrderStatus @default(PENDIENTE)
  shippingName    String
  shippingEmail   String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingNotes   String?
  paymentId       String?    @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payment         Payment?    @relation(fields: [paymentId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}
