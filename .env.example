# ── App ──
NODE_ENV=development
PORT=3001
API_PREFIX=api
# Orígenes CORS permitidos (múltiples separados por coma)
# Desarrollo: http://localhost:3000,http://<tu-ip-local>:3000
# Producción:  https://kamerinosspa.com
CORS_ORIGIN=http://localhost:3000
# Ejecuta el seed automáticamente si el admin no existe (solo desarrollo).
# En producción NO definirlo o dejarlo en false.
RUN_SEED=true

# ── Database (PostgreSQL + pgvector) ──
# Desarrollo:  kamerinos_db
# Tests E2E:   kamerinos_db_tests (definida en .env.test)
DATABASE_URL=postgresql://postgres:Colombia2026*@localhost:5432/kamerinos_db

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_SECRET=cambia-este-secreto-por-uno-seguro
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=1d

# ── Wompi ──
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_EVENTS_KEY=events_test_xxx
WOMPI_WEBHOOK_SECRET=whsec_xxx
WOMPI_INTEGRITY_SECRET=integ_xxx

# ── Google Calendar ──
GOOGLE_CLIENT_EMAIL=calendar@kamerinos.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

# ── WhatsApp / Meta ──
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
META_CAPI_ACCESS_TOKEN=
META_CAPI_PIXEL_ID=

# ── Chat IA (servicio saaspa-IA) ──
IA_BOT_URL=http://localhost:8000
# Timeout de la llamada a POST /api/v1/chat (ms). Al superarlo se responde 504.
# Debe ser MAYOR que el turn-deadline de saaspa-IA (20 s) y que su read-timeout por intento (8-10 s):
# escalera 25 s > 20 s > 10 s (hallazgo J-04). Si se mueve uno, se mueven los dos repos.
IA_BOT_TIMEOUT_MS=25000
# Secreto de la dirección NestJS -> saaspa-IA (X-Internal-Api-Key)
IA_BOT_API_KEY=
# Secreto de la dirección saaspa-IA -> NestJS (X-Internal-Api-Key). Distinto del anterior.
INTERNAL_API_KEY=
# Clave privada del turn token: PKCS#8 PEM (EC P-256) en base64 de UNA línea.
# Generarla con el comando documentado en docs/dev.md y NO commitear nunca la real.
TURN_TOKEN_PRIVATE_KEY=BASE64_PKCS8_PRIVATE_KEY_HERE
TURN_TOKEN_KID=
TURN_TOKEN_ISSUER=saaspa-backend
TURN_TOKEN_AUDIENCE=saaspa-ia
TURN_TOKEN_TTL_SECONDS=300
# Identidad del tenant. DEBE coincidir con IA_TENANT_DEFAULT de saaspa-IA (si no, responde 403).
TENANT_ID=kamerinos
# DEBE coincidir con saaspa.tenant.timezone de saaspa-IA.
TENANT_TIMEZONE=America/Bogota

# ── Agenda (política de reservas) ──
# Minutos que una cita puede quedarse en PENDIENTE_PAGO antes de liberar su franja.
# Pasado el plazo la cita pasa a EXPIRADA (barrido cada 5 min). Default 30.
BOOKING_PAYMENT_TTL_MINUTES=30
# Máximo de citas PENDIENTE_PAGO simultáneas por usuario (el camino admin no lo consume). Default 2.
BOOKING_MAX_PENDING_PER_USER=2

# ── Email transaccional (SendGrid) ──
# Sin API key, los emails se loguean en consola (desarrollo).
SENDGRID_API_KEY=
# Remitente de respuesta (opcional; default: kamerinosg@gmail.com)
SENDGRID_REPLY_TO=kamerinosg@gmail.com
# Copia interna de citas/pedidos para el personal (default: kamerinosg@gmail.com)
ADMIN_NOTIFY_EMAIL=kamerinosg@gmail.com
# Bandeja que recibe los avisos de handoff del chat (una clienta pide atención humana).
# Si se deja vacío se usa ADMIN_NOTIFY_EMAIL (no es un secreto, no rompe el arranque).
SALON_NOTIFICATION_EMAIL=

# ── Frontend (URL pública para enlaces del bot de WhatsApp) ──
FRONTEND_URL=https://kamerinos.sandrapinzonsaludybelleza.com.co
