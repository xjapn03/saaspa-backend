# ── Base de Datos de Tests (E2E) ──
# Esta base es SOLO para pruebas end-to-end.
# Se crea y destruye con datos de prueba, nunca datos reales.
# El resto de variables se heredan de .env (JWT_SECRET, etc.)
DATABASE_URL=postgresql://admin:Colombia2026*@localhost:5432/kamerinos_db_tests

# ── Tests ──
# NODE_ENV=test evita que main.ts ejecute prisma migrate deploy
NODE_ENV=test
# No ejecutar seed en tests E2E (los tests crean sus propios datos)
RUN_SEED=false

# ── Chat IA (valores de prueba, nunca reales) ──
# TURN_TOKEN_PRIVATE_KEY NO va aquí: se genera con el comando de docs/dev.md y vive
# en .env (local) o en el secreto del despliegue. El CI genera una clave efímera.
IA_BOT_API_KEY=test-ia-bot-key
INTERNAL_API_KEY=test-internal-key
TURN_TOKEN_KID=test-kid
TENANT_ID=kamerinos
TENANT_TIMEZONE=America/Bogota
