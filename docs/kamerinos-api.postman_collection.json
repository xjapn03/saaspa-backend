          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] } }
        },
        {
          "name": "PATCH /me — Editar perfil propio",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"phone\": \"3001112233\"\n}" }, "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] } }
        },
        {
          "name": "GET / — Listar usuarios (Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "var json = pm.response.json();", "if (json.length > 0) pm.collectionVariables.set('userId', json[0].id);"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] } }
        },
        {
          "name": "GET /:id — Ver usuario (Admin)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] } }
        },
        {
          "name": "PATCH /:id — Editar usuario (Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Editado\",\n  \"role\": \"CLIENTE\"\n}" }, "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] } }
        },
        {
          "name": "DELETE /:id — Soft delete (Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', function () { pm.response.to.have.status(204); });"], "type": "text/javascript" } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] } }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "GET /public — Listar servicios activos (Público)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "var json = pm.response.json();", "if (json.length > 0) pm.collectionVariables.set('serviceId', json[0].id);"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/services/public", "host": ["{{baseUrl}}"], "path": ["services", "public"] } }
        },
        {
          "name": "GET / — Listar todos (Admin/Empleado)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "var json = pm.response.json();", "if (json.length > 0) pm.collectionVariables.set('serviceId', json[0].id);"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/services", "host": ["{{baseUrl}}"], "path": ["services"] } }
        },
        {
          "name": "GET /:id — Detalle servicio",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["services", "{{serviceId}}"] } }
        },
        {
          "name": "POST / — Crear servicio (Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', function () { pm.response.to.have.status(201); });", "var json = pm.response.json();", "pm.collectionVariables.set('serviceId', json.id);"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Facial Premium\",\n  \"description\": \"Limpieza profunda con ácido hialurónico.\",\n  \"price\": 180000,\n  \"duration\": 75,\n  \"category\": \"Facial\"\n}" }, "url": { "raw": "{{baseUrl}}/services", "host": ["{{baseUrl}}"], "path": ["services"] } }
        },
        {
          "name": "PATCH /:id — Actualizar servicio (Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"price\": 200000,\n  \"category\": \"Facial Premium\"\n}" }, "url": { "raw": "{{baseUrl}}/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["services", "{{serviceId}}"] } }
        },
        {
          "name": "DELETE /:id — Desactivar (Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', function () { pm.response.to.have.status(204); });"], "type": "text/javascript" } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["services", "{{serviceId}}"] } }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "GET /slots — Disponibilidad (Público)",
          "description": "Requiere haber creado un servicio y tener su {{serviceId}}. Usa la fecha actual o una futura.",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "pm.test('Retorna array de slots', function () { pm.expect(pm.response.json()).to.be.an('array'); });"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/bookings/slots?serviceId={{serviceId}}&date=2026-08-15", "host": ["{{baseUrl}}"], "path": ["bookings", "slots"], "query": [{ "key": "serviceId", "value": "{{serviceId}}" }, { "key": "date", "value": "2026-08-15" }] } }
        },
        {
          "name": "POST / — Crear cita (Cliente)",
          "description": "Crea una cita con status PENDIENTE_PAGO. Usa un slot obtenido de GET /slots.",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', function () { pm.response.to.have.status(201); });", "var json = pm.response.json();", "pm.collectionVariables.set('bookingId', json.id);"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{clientAccessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"startTime\": \"2026-08-15T10:00:00.000Z\"\n}" }, "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] } }
        },
        {
          "name": "GET / — Listar citas (Auth)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] } }
        },
        {
          "name": "GET /:id — Detalle cita",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] } }
        },
        {
          "name": "PATCH /:id/confirm — Confirmar (Admin/Empleado)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "pm.test('Status cambia a CONFIRMADA', function () { pm.expect(pm.response.json().status).to.eql('CONFIRMADA'); });"], "type": "text/javascript" } }],
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/confirm", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "confirm"] } }
        },
        {
          "name": "PATCH /:id/complete — Completar (Admin/Empleado)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/complete", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "complete"] } }
        },
        {
          "name": "PATCH /:id/cancel — Cancelar (Dueño/Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "cancel"] } }
        }
      ]
    },
    {
